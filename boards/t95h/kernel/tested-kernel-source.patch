+static inline void __xradio_free_event_queue(struct list_head *list)
+{
+	while (!list_empty(list)) {
+		struct xradio_wsm_event *event =
+			list_first_entry(list, struct xradio_wsm_event,link);
+		list_del(&event->link);
+		kfree(event);
+	}
+}
