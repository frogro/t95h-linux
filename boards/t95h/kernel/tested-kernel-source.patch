+		if (priv->listening ^ listening) {
+			priv->listening = listening;
+			wsm_lock_tx(hw_priv);
+			xradio_update_listening(priv, listening);
+			wsm_unlock_tx(hw_priv);
+		}
+#endif
+		xradio_update_filtering(priv);
+		mutex_unlock(&hw_priv->conf_mutex);
+		up(&hw_priv->scan.lock);
+	}
+}
