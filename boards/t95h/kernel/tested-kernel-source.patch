+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// Fresh T95H experimental description: current IMAGEWTY + Android live DT.
+/dts-v1/;
+#include "sun50i-h616.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+/ {
+ model = "T95H H616 experimental SD-only";
+ compatible = "t95h,h616-tvbox", "allwinner,sun50i-h616";
+ aliases { serial0 = &uart0; mmc0 = &mmc0; };
+ chosen { stdout-path = "serial0:115200n8"; };
+ vcc5v: vcc5v { compatible = "regulator-fixed"; regulator-name = "vcc-5v"; regulator-min-microvolt = <5000000>; regulator-max-microvolt = <5000000>; regulator-always-on; };
+ // Rails initialized and ID-checked by SPL; no CPU OPP changes in this experiment.
+ vcc3v3: vcc3v3 { compatible = "regulator-fixed"; regulator-name = "vcc-3v3"; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-always-on; };
+ vcc1v8: vcc1v8 { compatible = "regulator-fixed"; regulator-name = "vcc-1v8"; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-always-on; };
+};
+&pio { vcc-pf-supply = <&vcc3v3>; vcc-ph-supply = <&vcc3v3>; vcc-pi-supply = <&vcc3v3>; };
+&mmc0 { vmmc-supply = <&vcc3v3>; cd-gpios = <&pio 8 16 GPIO_ACTIVE_LOW>; disable-wp; bus-width = <4>; max-frequency = <25000000>; no-mmc; no-sdio; status = "okay"; };
+&mmc1 { status = "disabled"; };
+&mmc2 { status = "disabled"; };
+&uart0 { pinctrl-names = "default"; pinctrl-0 = <&uart0_ph_pins>; status = "okay"; };
+// USB/HDMI/GPU/Wi-Fi remain disabled; OTG electrical controls unproven.
+/ { aliases { ethernet0 = &emac1; }; };
+&pio {
+ vcc-pa-supply = <&vcc3v3>;
+ i2c3_pa_pins: i2c3-pa-pins { pins = "PA10", "PA11"; function = "i2c3"; bias-pull-up; };
+};
+&sid {
+ ephy_config: ethernet-phy-configuration@2c { reg = <0x2c 2>; };
+};
+&pwm { pinctrl-names = "default"; pinctrl-0 = <&pwm5_pin>; status = "okay"; };
+&i2c3 {
+ pinctrl-0 = <&i2c3_pa_pins>; pinctrl-names = "default"; clock-frequency = <200000>; status = "okay";
+ ac200: mixed-signal@10 { compatible = "x-powers,ac200"; reg = <0x10>; clocks = <&pwm 5>; assigned-clocks = <&pwm 5>; assigned-clock-rates = <24000000>; };
+};
+&emac1 {
+ pinctrl-names = "default"; pinctrl-0 = <&rmii_emac1_pins>;
+ phy-mode = "rmii"; phy-handle = <&ephy>; phy-supply = <&vcc3v3>;
+ allwinner,tx-delay-ps = <700>; allwinner,rx-delay-ps = <3100>;
+ status = "okay";
+};
+&mdio1 {
+ ethernet-phy-package@0 {
+  compatible = "x-powers,ac200-ephy-package";
+  reg = <0>; #address-cells = <1>; #size-cells = <0>;
+  vcc-supply = <&vcc3v3>; x-powers,ac200 = <&ac200>;
+  nvmem-cells = <&ephy_config>;
+  nvmem-cell-names = "configuration";
+  /* 6.12 regulator API resolves the consumer node; mirror package supply. */
+  ephy: ethernet-phy@0 { vcc-supply = <&vcc3v3>; compatible = "ethernet-phy-id0044.1400"; reg = <0>; };
+ };
+};
+
+// Android live DT: SDIO PG0..5 at 1.8 V, REGON PG18, clock PG10.
+#include <dt-bindings/clock/sun6i-rtc.h>
+/ {
+ aliases { ethernet1 = &xr819; mmc1 = &mmc1; };
+ wifi_pwrseq: wifi-pwrseq {
+  compatible = "mmc-pwrseq-simple";
+  pinctrl-names = "default";
+  pinctrl-0 = <&wifi_clk_pin>;
+  clocks = <&rtc CLK_OSC32K_FANOUT>;
+  clock-names = "ext_clock";
+  reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>;
+  post-power-on-delay-ms = <100>;
+ };
+ usb1_vbus: regulator-usb1-vbus {
+  compatible = "regulator-fixed";
+  regulator-name = "usb1-vbus";
+  regulator-min-microvolt = <5000000>;
+  regulator-max-microvolt = <5000000>;
+  vin-supply = <&vcc5v>;
+  gpio = <&pio 7 8 GPIO_ACTIVE_HIGH>;
+  enable-active-high;
+ };
+};
+&pio {
+ vcc-pg-supply = <&vcc1v8>;
+ wifi_clk_pin: wifi-clk-pin { pins = "PG10"; function = "clock"; };
+ wifi_wake_pin: wifi-wake-pin { pins = "PG15"; function = "gpio_in"; };
+};
+&mmc1 {
+ /delete-property/ vmmc-supply;
+ voltage-ranges = <1650 1950 3200 3400>;
+ vqmmc-supply = <&vcc1v8>;
+ mmc-pwrseq = <&wifi_pwrseq>;
+ bus-width = <4>;
+ max-frequency = <25000000>;
+ non-removable;
+ no-mmc;
+ no-sd;
+ cap-sdio-irq;
+ keep-power-in-suspend;
+ /delete-property/ mmc-ddr-3_3v;
+ status = "okay";
+ xr819: wifi@1 {
+  reg = <1>;
+  compatible = "xradio,xr819";
+  pinctrl-names = "default";
+  pinctrl-0 = <&wifi_wake_pin>;
+  interrupt-parent = <&pio>;
+  interrupts = <6 15 IRQ_TYPE_EDGE_RISING>;
+  interrupt-names = "host-wake";
+ };
+};
+// Enable the dedicated hosts. OTG0 remains disabled pending role wiring.
+&usbphy {
+ usb1_vbus-supply = <&usb1_vbus>;
+ usb2_vbus-supply = <&vcc5v>;
+ usb3_vbus-supply = <&vcc5v>;
+ status = "okay";
+};
+&ehci1 { status = "okay"; };
+&ohci1 { status = "okay"; };
+&ehci2 { status = "okay"; };
+&ohci2 { status = "okay"; };
+&ehci3 { status = "okay"; };
+&ohci3 { status = "okay"; };
+
+// HDMI connector and one DE33 pipeline; no GPU, audio or PMIC changes.
+/ {
+ hdmi_connector: connector {
+  compatible = "hdmi-connector";
+  type = "a";
+  port { hdmi_connector_in: endpoint { remote-endpoint = <&hdmi_out_connector>; }; };
+ };
+};
+&de { status = "okay"; };
+&hdmi { hvcc-supply = <&vcc3v3>; status = "okay"; };
+&hdmi_out { hdmi_out_connector: endpoint { remote-endpoint = <&hdmi_connector_in>; }; };
+&tcon_tv0 { status = "okay"; };
+
+&tcon_tv1 { status = "disabled"; };
+
+// Candidate3: isolated input/audio/display additions. Preserved storage/EMAC boot wiring.
+&wifi_pwrseq { post-power-on-delay-ms = <300>; power-off-delay-us = <100000>; };
+&mmc1 { t95h,retry-empty-sdio-ocr; };
+&codec { allwinner,audio-routing = "Line Out", "LINEOUT"; status = "okay"; };
+&hdmi { #sound-dai-cells = <0>; };
+&ahub_dam_plat { status = "okay"; };
+&ahub1_plat { status = "okay"; };
+&ahub1_mach { status = "okay"; };
+/ {
+ i2c-display {
+  compatible = "i2c-gpio";
+  sda-gpios = <&pio 8 12 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  scl-gpios = <&pio 8 11 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  i2c-gpio,delay-us = <5>;
+  #address-cells = <1>; #size-cells = <0>;
+  display@24 {
+   compatible = "fdhisi,fd655"; reg = <0x24>;
+   label = "t95h:display"; default-brightness = <1>;
+   digits { #address-cells = <1>; #size-cells = <0>;
+    digit@0 { reg = <0>; segments = <1 3>, <1 4>, <1 5>, <1 0>, <1 1>, <1 2>, <1 6>; };
+    digit@1 { reg = <1>; segments = <2 3>, <2 4>, <2 5>, <2 0>, <2 1>, <2 2>, <2 6>; };
+    digit@2 { reg = <2>; segments = <3 3>, <3 4>, <3 5>, <3 0>, <3 1>, <3 2>, <3 6>; };
+    digit@3 { reg = <3>; segments = <4 3>, <4 4>, <4 5>, <4 0>, <4 1>, <4 2>, <4 6>; };
+   };
+   leds { #address-cells = <2>; #size-cells = <0>;
+    led@0,1 { reg = <0 1>; function = "usb"; };
+    led@0,2 { reg = <0 2>; function = "play"; };
+    led@0,3 { reg = <0 3>; function = "pause"; };
+    led@0,4 { reg = <0 4>; function = "colon"; };
+    led@0,5 { reg = <0 5>; function = "ethernet"; };
