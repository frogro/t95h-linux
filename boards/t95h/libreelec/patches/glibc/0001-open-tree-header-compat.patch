Subject: [PATCH] Guard OPEN_TREE macros against newer Linux UAPI headers

Backport of glibc d12b017cddfeb9fe9920ba054ae3dfcb8e9238b8
by Florian Weimer, adapted to the LibreELEC 12.2 glibc header.
Upstream: https://sourceware.org/pipermail/glibc-bugs/2026-March/060959.html

--- a/sysdeps/unix/sysv/linux/sys/mount.h
+++ b/sysdeps/unix/sysv/linux/sys/mount.h
@@ -262,8 +262,12 @@
 #define FSOPEN_CLOEXEC          0x00000001
 
 /* open_tree flags.  */
-#define OPEN_TREE_CLONE    1         /* Clone the target tree and attach the clone */
-#define OPEN_TREE_CLOEXEC  O_CLOEXEC /* Close the file on execve() */
+#ifndef OPEN_TREE_CLONE
+# define OPEN_TREE_CLONE    1         /* Clone the target tree and attach the clone */
+#endif
+#ifndef OPEN_TREE_CLOEXEC
+# define OPEN_TREE_CLOEXEC  O_CLOEXEC /* Close the file on execve() */
+#endif
 
 
 __BEGIN_DECLS
