#!/bin/sh
# cfg80211 is built in and can request its database before firmware overlays exist.
set -eu
base=/usr/lib/kernel-overlays/base/lib/firmware
runtime=/run/kernel-overlays/firmware
mkdir -p "$runtime"
for name in regulatory.db regulatory.db.p7s; do
  [ -s "$base/$name" ] || { echo "T95H: missing $base/$name" >&2; exit 1; }
  if [ ! -e "$runtime/$name" ]; then
    ln -sfn "$base/$name" "$runtime/$name"
  fi
done
# Retain the user's country selection; never hard-code a regulatory domain.
# The initial asynchronous request can still be pending during early boot.
# Retry the real reload, and retain a failing exit status if it never succeeds.
n=0
while ! iw reg reload; do
  n=$((n+1))
  if [ "$n" -ge 15 ]; then
    echo 'T95H: regulatory reload failed after 15 attempts' >&2
    exit 1
  fi
  sleep 1
done
echo 'T95H: regulatory database reload requested after firmware setup'
