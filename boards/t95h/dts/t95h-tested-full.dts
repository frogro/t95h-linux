/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "T95H H616 experimental SD-only";
	compatible = "t95h,h616-tvbox", "allwinner,sun50i-h616";

	opp-table-gpu {
		phandle = <0x54>;
		compatible = "operating-points-v2";

		opp-600000000 {
			opp-microvolt = <0xea600 0xea600 0x10c8e0>;
			opp-hz = <0x00 0x23c34600>;
		};

		opp-576000000 {
			opp-microvolt = <0xea600 0xea600 0x10c8e0>;
			opp-hz = <0x00 0x22551000>;
		};

		opp-540000000 {
			opp-microvolt = <0xea600 0xea600 0x10c8e0>;
			opp-hz = <0x00 0x202fbf00>;
		};

		opp-504000000 {
			opp-microvolt = <0xea600 0xea600 0x10c8e0>;
			opp-hz = <0x00 0x1e0a6e00>;
		};
	};

	opp-table-cpu-test {
		opp-shared;
		nvmem-cells = <0x4f>;
		phandle = <0x50>;
		compatible = "allwinner,sun50i-h616-operating-points";

		opp-1512000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0x10c8e0>;
			opp-hz = <0x00 0x5a1f4a00>;
		};

		opp-1416000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0x10c8e0>;
			opp-hz = <0x00 0x54667200>;
		};

		opp-1320000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0x10c8e0>;
			opp-hz = <0x00 0x4ead9a00>;
		};

		opp-1200000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0x100590>;
			opp-hz = <0x00 0x47868c00>;
		};

		opp-1104000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x41cdb400>;
		};

		opp-1008000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0xe7ef0>;
			opp-hz = <0x00 0x3c14dc00>;
		};

		opp-936000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0xdbba0>;
			opp-hz = <0x00 0x37ca3a00>;
		};

		opp-720000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0xdbba0>;
			opp-hz = <0x00 0x2aea5400>;
		};

		opp-480000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0xdbba0>;
			opp-hz = <0x00 0x1c9c3800>;
		};

		opp-408000000 {
			opp-supported-hw = <0x08>;
			clock-latency-ns = <0x4c4b40>;
			opp-microvolt = <0xdbba0>;
			opp-hz = <0x00 0x18519600>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			cpu-supply = <0x4e>;
			operating-points-v2 = <0x50>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x00>;
			enable-method = "psci";
			clocks = <0x02 0x15>;
			#cooling-cells = <0x02>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x03>;
			phandle = <0x05>;
		};

		cpu@1 {
			operating-points-v2 = <0x50>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x01>;
			enable-method = "psci";
			clocks = <0x02 0x15>;
			#cooling-cells = <0x02>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x03>;
			phandle = <0x06>;
		};

		cpu@2 {
			operating-points-v2 = <0x50>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x02>;
			enable-method = "psci";
			clocks = <0x02 0x15>;
			#cooling-cells = <0x02>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x03>;
			phandle = <0x07>;
		};

		cpu@3 {
			operating-points-v2 = <0x50>;
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x03>;
			enable-method = "psci";
			clocks = <0x02 0x15>;
			#cooling-cells = <0x02>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x03>;
			phandle = <0x08>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x40000>;
			cache-line-size = <0x40>;
			cache-sets = <0x100>;
			phandle = <0x03>;
		};
	};

	display-engine {
		compatible = "allwinner,sun50i-h616-display-engine";
		allwinner,pipelines = <0x04>;
		status = "okay";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		secmon@40000000 {
			reg = <0x00 0x40000000 0x00 0x40000>;
			no-map;
		};
	};

	osc24M-clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "osc24M";
		phandle = <0x0f>;
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <0x00 0x8c 0x04 0x00 0x8d 0x04 0x00 0x8e 0x04 0x00 0x8f 0x04>;
		interrupt-affinity = <0x05 0x06 0x07 0x08>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		arm,no-tick-in-suspend;
		interrupts = <0x01 0x0d 0xf04 0x01 0x0e 0xf04 0x01 0x0b 0xf04 0x01 0x0a 0xf04>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0x40000000>;

		video-codec@1c0e000 {
			allwinner,sram = <0x59 0x01 0x09 0x01>;
			iommus = <0x58 0x03 0x58 0x02>;
			interrupts = <0x00 0x5d 0x04>;
			resets = <0x02 0x05>;
			clock-names = "ahb", "mod", "ram";
			clocks = <0x02 0x29 0x02 0x28 0x02 0x33>;
			reg = <0x1c0e000 0x2000>;
			compatible = "allwinner,sun50i-h616-video-engine";
		};

		bus@1000000 {
			compatible = "allwinner,sun50i-h616-de33", "allwinner,sun50i-a64-de2";
			reg = <0x1000000 0x400000>;
			allwinner,sram = <0x09 0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x1000000 0x400000>;

			planes@100000 {
				phandle = <0x57>;
				allwinner,plane-mapping = <0x0a>;
				reg = <0x100000 0x180000>;
				compatible = "allwinner,sun50i-h616-de33-planes";
			};

			clock@8000 {
				compatible = "allwinner,sun50i-h616-de33-clk";
				reg = <0x8000 0x100>;
				clocks = <0x02 0x1e 0x02 0x1d>;
				clock-names = "bus", "mod";
				resets = <0x02 0x01>;
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;
				phandle = <0x0a>;
			};

			mixer@280000 {
				iommus = <0x58 0x00>;
				allwinner,planes = <0x57>;
				compatible = "allwinner,sun50i-h616-de33-mixer-0";
				reg = <0x280000 0x20000 0x8100 0x40>;
				reg-names = "display", "top";
				clocks = <0x0a 0x00 0x0a 0x06>;
				clock-names = "bus", "mod";
				resets = <0x0a 0x00>;
				phandle = <0x04>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0x0b>;
							phandle = <0x2e>;
						};
					};
				};
			};

			mixer@2a0000 {
				allwinner,planes = <0x57>;
				status = "disabled";
				compatible = "allwinner,sun50i-h616-de33-mixer-0";
				reg = <0x2a0000 0x20000 0x8140 0x40>;
				reg-names = "display", "top";
				clocks = <0x0a 0x00 0x0a 0x07>;
				clock-names = "bus", "mod";
				resets = <0x0a 0x01>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0x0c>;
							phandle = <0x33>;
						};
					};
				};
			};
		};

		gpu@1800000 {
			phandle = <0x55>;
			#cooling-cells = <0x02>;
			operating-points-v2 = <0x54>;
			mali-supply = <0x53>;
			compatible = "allwinner,sun50i-h616-mali", "arm,mali-bifrost";
			reg = <0x1800000 0x40000>;
			interrupts = <0x00 0x5f 0x04 0x00 0x60 0x04 0x00 0x61 0x04>;
			interrupt-names = "job", "mmu", "gpu";
			clocks = <0x02 0x23 0x02 0x24>;
			clock-names = "core", "bus";
			power-domains = <0x0d 0x02>;
			resets = <0x02 0x03>;
			status = "okay";
		};

		crypto@1904000 {
			compatible = "allwinner,sun50i-h616-crypto";
			reg = <0x1904000 0x800>;
			interrupts = <0x00 0x5b 0x04>;
			clocks = <0x02 0x27 0x02 0x26 0x02 0x34 0x0e 0x02>;
			clock-names = "bus", "mod", "ram", "trng";
			resets = <0x02 0x04>;
		};

		syscon@3000000 {
			compatible = "allwinner,sun50i-h616-system-control";
			reg = <0x3000000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			phandle = <0x1e>;

			sram@28000 {
				compatible = "mmio-sram";
				reg = <0x28000 0x30000>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x28000 0x30000>;

				sram-section@0 {
					compatible = "allwinner,sun50i-h616-sram-c", "allwinner,sun50i-a64-sram-c";
					reg = <0x00 0x30000>;
					phandle = <0x09>;
				};
			};

			sram@1a00000 {
				compatible = "mmio-sram";
				reg = <0x1a00000 0x200000>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x1a00000 0x200000>;

				sram-section@0 {
					phandle = <0x59>;
					compatible = "allwinner,sun50i-h616-ve-sram";
					reg = <0x00 0x200000>;
				};
			};
		};

		clock@3001000 {
			compatible = "allwinner,sun50i-h616-ccu";
			reg = <0x3001000 0x1000>;
			clocks = <0x0f 0x0e 0x00 0x0e 0x02>;
			clock-names = "hosc", "losc", "iosc";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x02>;
		};

		dma-controller@3002000 {
			compatible = "allwinner,sun50i-h616-dma", "allwinner,sun50i-a100-dma";
			reg = <0x3002000 0x1000>;
			interrupts = <0x00 0x2a 0x04>;
			clocks = <0x02 0x2a 0x02 0x32>;
			clock-names = "bus", "mbus";
			dma-channels = <0x10>;
			dma-requests = <0x31>;
			resets = <0x02 0x06>;
			#dma-cells = <0x01>;
			phandle = <0x13>;
		};

		efuse@3006000 {
			compatible = "allwinner,sun50i-h616-sid", "allwinner,sun50i-a64-sid";
			reg = <0x3006000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			thermal-sensor-calibration@14 {
				reg = <0x14 0x08>;
				phandle = <0x23>;
			};

			cpu-speed-grade@0 {
				phandle = <0x4f>;
				reg = <0x00 0x02>;
			};

			ethernet-phy-configuration@2c {
				reg = <0x2c 0x02>;
				phandle = <0x22>;
			};
		};

		timer@3009000 {
			compatible = "allwinner,sun50i-h616-timer", "allwinner,sun8i-a23-timer";
			reg = <0x3009000 0xa0>;
			interrupts = <0x00 0x30 0x04 0x00 0x31 0x04>;
			clocks = <0x0f>;
		};

		hstimer@3005000 {
			compatible = "allwinner,sun50i-h616-hstimer", "allwinner,sun20i-d1-hstimer";
			reg = <0x3005000 0x1000>;
			interrupts = <0x00 0x2d 0x04 0x00 0x2e 0x04>;
			clocks = <0x02 0x2b>;
			resets = <0x02 0x07>;
		};

		watchdog@30090a0 {
			compatible = "allwinner,sun50i-h616-wdt", "allwinner,sun6i-a31-wdt";
			reg = <0x30090a0 0x20>;
			interrupts = <0x00 0x32 0x04>;
			clocks = <0x0f>;
		};

		pwm@300a000 {
			compatible = "allwinner,sun50i-h616-pwm";
			reg = <0x300a000 0x400>;
			clocks = <0x0f 0x02 0x2f>;
			clock-names = "mod", "bus";
			resets = <0x02 0x0a>;
			#pwm-cells = <0x03>;
			#clock-cells = <0x01>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x10>;
			phandle = <0x1d>;
		};

		pinctrl@300b000 {
			compatible = "allwinner,sun50i-h616-pinctrl";
			reg = <0x300b000 0x400>;
			interrupts = <0x00 0x33 0x04 0x00 0x34 0x04 0x00 0x35 0x04 0x00 0x2b 0x04 0x00 0x36 0x04 0x00 0x37 0x04 0x00 0x38 0x04 0x00 0x39 0x04>;
			clocks = <0x02 0x1a 0x0f 0x0e 0x00>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <0x03>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			vcc-pf-supply = <0x11>;
			vcc-ph-supply = <0x11>;
			vcc-pi-supply = <0x11>;
			vcc-pa-supply = <0x11>;
			vcc-pg-supply = <0x12>;
			phandle = <0x15>;

			rgmii-pins {
				pins = "PI0", "PI1", "PI2", "PI3", "PI4", "PI5", "PI7", "PI8", "PI9", "PI10", "PI11", "PI12", "PI13", "PI14", "PI15", "PI16";
				function = "emac0";
				drive-strength = <0x28>;
			};

			rmii-emac1-pins {
				pins = "PA0", "PA1", "PA2", "PA3", "PA4", "PA5", "PA6", "PA7", "PA8", "PA9";
				function = "emac1";
				drive-strength = <0x28>;
				phandle = <0x1f>;
			};

			i2c0-pins {
				pins = "PI5", "PI6";
				function = "i2c0";
				phandle = <0x1b>;
			};

			i2c3-ph-pins {
				pins = "PH4", "PH5";
				function = "i2c3";
			};

			ir-rx-pin {
				pins = "PH10";
				function = "ir_rx";
				phandle = <0x47>;
			};

			mmc0-pins {
				pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
				function = "mmc0";
				drive-strength = <0x1e>;
				bias-pull-up;
				phandle = <0x14>;
			};

			mmc1-pins {
				pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
				function = "mmc1";
				drive-strength = <0x1e>;
				bias-pull-up;
				phandle = <0x16>;
			};

			mmc2-pins {
				pins = "PC0", "PC1", "PC5", "PC6", "PC8", "PC9", "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
				function = "mmc2";
				drive-strength = <0x1e>;
				bias-pull-up;
				phandle = <0x19>;
			};

			pwm5-pin {
				pins = "PA12";
				function = "pwm5";
				phandle = <0x10>;
			};

			spdif-tx-pin {
				pins = "PH4";
				function = "spdif";
				phandle = <0x24>;
			};

			uart0-ph-pins {
				pins = "PH0", "PH1";
				function = "uart0";
				phandle = <0x1a>;
			};

			i2c3-pa-pins {
				pins = "PA10", "PA11";
				function = "i2c3";
				bias-pull-up;
				phandle = <0x1c>;
			};

			wifi-clk-pin {
				pins = "PG10";
				function = "clock";
				phandle = <0x4b>;
			};

			wifi-wake-pin {
				pins = "PG15";
				function = "gpio_in";
				phandle = <0x18>;
			};
		};

		interrupt-controller@3021000 {
			compatible = "arm,gic-400";
			reg = <0x3021000 0x1000 0x3022000 0x2000 0x3024000 0x2000 0x3026000 0x2000>;
			interrupts = <0x01 0x09 0xf04>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			phandle = <0x01>;
		};

		iommu@30f0000 {
			phandle = <0x58>;
			compatible = "allwinner,sun50i-h616-iommu";
			reg = <0x30f0000 0x10000>;
			interrupts = <0x00 0x3d 0x04>;
			clocks = <0x02 0x30>;
			resets = <0x02 0x0b>;
			#iommu-cells = <0x01>;
		};

		nand-controller@4011000 {
			compatible = "allwinner,sun50i-h616-nand-controller";
			reg = <0x4011000 0x1000>;
			interrupts = <0x00 0x22 0x04>;
			clocks = <0x02 0x3b 0x02 0x39 0x02 0x3a 0x02 0x36>;
			clock-names = "ahb", "mod", "ecc", "mbus";
			resets = <0x02 0x0d>;
			reset-names = "ahb";
			dmas = <0x13 0x0a>;
			dma-names = "rxtx";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		mmc@4020000 {
			compatible = "allwinner,sun50i-h616-mmc", "allwinner,sun50i-a100-mmc";
			reg = <0x4020000 0x1000>;
			clocks = <0x02 0x3f 0x02 0x3c>;
			clock-names = "ahb", "mmc";
			resets = <0x02 0x0e>;
			reset-names = "ahb";
			interrupts = <0x00 0x23 0x04>;
			pinctrl-names = "default";
			pinctrl-0 = <0x14>;
			status = "okay";
			max-frequency = <0x17d7840>;
			cap-sd-highspeed;
			cap-mmc-highspeed;
			mmc-ddr-3_3v;
			cap-sdio-irq;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			vmmc-supply = <0x11>;
			cd-gpios = <0x15 0x08 0x10 0x01>;
			disable-wp;
			bus-width = <0x04>;
			no-mmc;
			no-sdio;
		};

		mmc@4021000 {
			vmmc-supply = <0x4d>;
			compatible = "allwinner,sun50i-h616-mmc", "allwinner,sun50i-a100-mmc";
			reg = <0x4021000 0x1000>;
			clocks = <0x02 0x40 0x02 0x3d>;
			clock-names = "ahb", "mmc";
			resets = <0x02 0x0f>;
			reset-names = "ahb";
