			reg = <0x6510000 0x1000>;
			clocks = <0x02 0x76 0x02 0x77 0x02 0x7b 0x02 0x78>;
			clock-names = "bus", "tcon-tv0", "tve0", "tcon-tv1";
			clock-output-names = "tcon-top-tv0", "tcon-top-tv1";
			resets = <0x02 0x35>;
			#clock-cells = <0x01>;
			phandle = <0x3f>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x2e>;
						phandle = <0x0b>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x2f>;
						phandle = <0x3b>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x30>;
						phandle = <0x3d>;
					};

					endpoint@2 {
						reg = <0x02>;
						remote-endpoint = <0x31>;
						phandle = <0x40>;
					};

					endpoint@3 {
						reg = <0x03>;
						remote-endpoint = <0x32>;
						phandle = <0x43>;
					};
				};

				port@2 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x02>;

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x33>;
						phandle = <0x0c>;
					};
				};

				port@3 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x03>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x34>;
						phandle = <0x3c>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x35>;
						phandle = <0x3e>;
					};

					endpoint@2 {
						reg = <0x02>;
						remote-endpoint = <0x36>;
						phandle = <0x41>;
					};

					endpoint@3 {
						reg = <0x03>;
						remote-endpoint = <0x37>;
						phandle = <0x44>;
					};
				};

				port@4 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x04>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x38>;
						phandle = <0x42>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x39>;
						phandle = <0x45>;
					};
				};

				port@5 {
					reg = <0x05>;

					endpoint {
						remote-endpoint = <0x3a>;
						phandle = <0x2c>;
					};
				};
			};
		};

		lcd-controller@6511000 {
			compatible = "allwinner,sun50i-h616-tcon-lcd", "allwinner,sun8i-r40-tcon-lcd";
			reg = <0x6511000 0x1000>;
			interrupts = <0x00 0x40 0x04>;
			clocks = <0x02 0x83 0x02 0x82>;
			clock-names = "ahb", "tcon-ch0";
			clock-output-names = "tcon-data-clock";
			#clock-cells = <0x00>;
			resets = <0x02 0x3d 0x02 0x3f>;
			reset-names = "lcd", "lvds";
			status = "disabled";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x3b>;
						phandle = <0x2f>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x3c>;
						phandle = <0x34>;
					};
				};

				port@1 {
					reg = <0x01>;
				};
			};
		};

		lcd-controller@6512000 {
			compatible = "allwinner,sun50i-h616-tcon-lcd", "allwinner,sun8i-r40-tcon-lcd";
			reg = <0x6512000 0x1000>;
			interrupts = <0x00 0x41 0x04>;
			clocks = <0x02 0x85 0x02 0x84>;
			clock-names = "ahb", "tcon-ch0";
			clock-output-names = "tcon-data-clock";
			#clock-cells = <0x00>;
			resets = <0x02 0x3e 0x02 0x3f>;
			reset-names = "lcd", "lvds";
			status = "disabled";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x3d>;
						phandle = <0x30>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x3e>;
						phandle = <0x35>;
					};
				};

				port@1 {
					reg = <0x01>;
				};
			};
		};

		lcd-controller@6515000 {
			compatible = "allwinner,sun50i-h616-tcon-tv";
			reg = <0x6515000 0x1000>;
			interrupts = <0x00 0x42 0x04>;
			clocks = <0x02 0x79 0x3f 0x00>;
			clock-names = "ahb", "tcon-ch1";
			resets = <0x02 0x36>;
			reset-names = "lcd";
			status = "okay";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x40>;
						phandle = <0x31>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x41>;
						phandle = <0x36>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x42>;
						phandle = <0x38>;
					};
				};
			};
		};

		lcd-controller@6516000 {
			compatible = "allwinner,sun50i-h616-tcon-tv";
			reg = <0x6516000 0x1000>;
			interrupts = <0x00 0x43 0x04>;
			clocks = <0x02 0x7a 0x3f 0x01>;
			clock-names = "ahb", "tcon-ch1";
			resets = <0x02 0x37>;
			reset-names = "lcd";
			status = "disabled";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x43>;
						phandle = <0x32>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x44>;
						phandle = <0x37>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x45>;
						phandle = <0x39>;
					};
				};
			};
		};

		rtc@7000000 {
			compatible = "allwinner,sun50i-h616-rtc";
			reg = <0x7000000 0x400>;
			interrupts = <0x00 0x68 0x04>;
			clocks = <0x46 0x0e 0x0f 0x02 0x80>;
			clock-names = "bus", "hosc", "pll-32k";
			#clock-cells = <0x01>;
			phandle = <0x0e>;
		};

		clock@7010000 {
			compatible = "allwinner,sun50i-h616-r-ccu";
			reg = <0x7010000 0x210>;
			clocks = <0x0f 0x0e 0x00 0x0e 0x02 0x02 0x04>;
			clock-names = "hosc", "losc", "iosc", "pll-periph";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x46>;
		};

		power-controller@7010250 {
			compatible = "allwinner,sun50i-h616-prcm-ppu";
			reg = <0x7010250 0x10>;
			#power-domain-cells = <0x01>;
			phandle = <0x0d>;
		};

		interrupt-controller@7010320 {
			compatible = "allwinner,sun50i-h616-nmi", "allwinner,sun9i-a80-nmi";
			reg = <0x7010320 0x0c>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0x67 0x04>;
		};

		pinctrl@7022000 {
			compatible = "allwinner,sun50i-h616-r-pinctrl";
			reg = <0x7022000 0x400>;
			clocks = <0x46 0x02 0x0f 0x0e 0x00>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <0x03>;

			r-i2c-pins {
				pins = "PL0", "PL1";
				function = "s_i2c";
				phandle = <0x48>;
			};

			r-rsb-pins {
				pins = "PL0", "PL1";
				function = "s_rsb";
				phandle = <0x49>;
			};
		};

		ir@7040000 {
			compatible = "allwinner,sun50i-h616-ir", "allwinner,sun6i-a31-ir";
			reg = <0x7040000 0x400>;
			interrupts = <0x00 0x6a 0x04>;
			clocks = <0x46 0x09 0x46 0x0b>;
			clock-names = "apb", "ir";
			resets = <0x46 0x05>;
			pinctrl-names = "default";
			pinctrl-0 = <0x47>;
			status = "okay";
		};

		i2c@7081400 {
			compatible = "allwinner,sun50i-h616-i2c", "allwinner,sun8i-v536-i2c", "allwinner,sun6i-a31-i2c";
			reg = <0x7081400 0x400>;
			interrupts = <0x00 0x69 0x04>;
			clocks = <0x46 0x08>;
			dmas = <0x13 0x30 0x13 0x30>;
			dma-names = "rx", "tx";
			resets = <0x46 0x04>;
			pinctrl-names = "default";
			pinctrl-0 = <0x48>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			regulator@36 {
				regulator-boot-on;
				regulator-always-on;
				regulator-max-microvolt = <0x325aa0>;
				regulator-min-microvolt = <0x325aa0>;
				regulator-name = "t95h-aldo2-wlan";
				phandle = <0x4d>;
				reg = <0x36>;
				compatible = "t95h,aldo2-only-test";

				gpu-regulator {
					regulator-boot-on;
					regulator-always-on;
					phandle = <0x53>;
					regulator-max-microvolt = <0x10c8e0>;
					regulator-min-microvolt = <0xea600>;
					regulator-name = "t95h-gpu-inherited";
				};

				cpu-regulator {
					regulator-boot-on;
					regulator-always-on;
					phandle = <0x4e>;
					regulator-max-microvolt = <0x111700>;
					regulator-min-microvolt = <0xdbba0>;
					regulator-name = "t95h-cpu-dcdca";
				};
			};
		};

		rsb@7083000 {
			compatible = "allwinner,sun50i-h616-rsb", "allwinner,sun8i-a23-rsb";
			reg = <0x7083000 0x400>;
			interrupts = <0x00 0x6d 0x04>;
			clocks = <0x46 0x0d>;
			clock-frequency = <0x2dc6c0>;
			resets = <0x46 0x07>;
			pinctrl-names = "default";
			pinctrl-0 = <0x49>;
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
		};
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0x1f4>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x4a 0x02>;
			sustainable-power = <0x3e8>;

			cooling-maps {

				map1 {
					cooling-device = <0x05 0x09 0x09 0x06 0x09 0x09 0x07 0x09 0x09 0x08 0x09 0x09>;
					trip = <0x52>;
				};

				map0 {
					cooling-device = <0x05 0x06 0x09 0x06 0x06 0x09 0x07 0x06 0x09 0x08 0x06 0x09>;
					trip = <0x51>;
				};
			};

			trips {

				cpu-trip-0 {
					phandle = <0x51>;
					temperature = <0xea60>;
					type = "passive";
					hysteresis = <0x7d0>;
				};

				cpu-trip-1 {
					phandle = <0x52>;
					temperature = <0x11170>;
					type = "passive";
					hysteresis = <0x7d0>;
				};

				cpu-trip-2 {
					temperature = <0x1adb0>;
					type = "critical";
					hysteresis = <0x00>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0x1f4>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x4a 0x00>;
			sustainable-power = <0x44c>;

			cooling-maps {

				map0 {
					cooling-device = <0x55 0x03 0x03>;
					trip = <0x56>;
				};
			};

			trips {

				gpu-passive {
					phandle = <0x56>;
					hysteresis = <0x7d0>;
					temperature = <0xfde8>;
					type = "passive";
				};

				gpu-trip-0 {
					temperature = <0x1adb0>;
					type = "critical";
					hysteresis = <0x00>;
				};
			};
		};

		ve-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0x4a 0x01>;

			trips {

				ve-trip-0 {
					temperature = <0x1adb0>;
					type = "critical";
					hysteresis = <0x00>;
				};
			};
		};

		ddr-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0x4a 0x03>;

			trips {

				ddr-trip-0 {
					temperature = <0x1adb0>;
					type = "critical";
					hysteresis = <0x00>;
				};
			};
		};
	};

	aliases {
		serial0 = "/soc/serial@5000000";
		mmc0 = "/soc/mmc@4020000";
		ethernet0 = "/soc/ethernet@5030000";
		ethernet1 = "/soc/mmc@4021000/wifi@1";
		mmc1 = "/soc/mmc@4021000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
		phandle = <0x2a>;
	};

	vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-always-on;
		phandle = <0x11>;
	};

	vcc1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-1v8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		phandle = <0x12>;
	};

	wifi-pwrseq {
		assigned-clock-parents = <0x0e 0x05>;
		assigned-clocks = <0x0e 0x01>;
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <0x4b>;
		clocks = <0x0e 0x01>;
		clock-names = "ext_clock";
		reset-gpios = <0x15 0x06 0x12 0x01>;
		post-power-on-delay-ms = <0x12c>;
		power-off-delay-us = <0x186a0>;
		phandle = <0x17>;
	};

	regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1-vbus";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x2a>;
		gpio = <0x15 0x07 0x08 0x00>;
		enable-active-high;
		phandle = <0x29>;
	};

	connector {
		compatible = "hdmi-connector";
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x4c>;
				phandle = <0x2d>;
			};
		};
	};

	i2c-display {
		compatible = "i2c-gpio";
		sda-gpios = <0x15 0x08 0x0c 0x06>;
		scl-gpios = <0x15 0x08 0x0b 0x06>;
		i2c-gpio,delay-us = <0x05>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		display@24 {
			compatible = "fdhisi,fd655";
			reg = <0x24>;
			label = "t95h:display";
			default-brightness = <0x01>;

			digits {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				digit@0 {
					reg = <0x00>;
					segments = <0x01 0x03 0x01 0x04 0x01 0x05 0x01 0x00 0x01 0x01 0x01 0x02 0x01 0x06>;
				};

				digit@1 {
					reg = <0x01>;
					segments = <0x02 0x03 0x02 0x04 0x02 0x05 0x02 0x00 0x02 0x01 0x02 0x02 0x02 0x06>;
				};

				digit@2 {
					reg = <0x02>;
					segments = <0x03 0x03 0x03 0x04 0x03 0x05 0x03 0x00 0x03 0x01 0x03 0x02 0x03 0x06>;
				};

				digit@3 {
					reg = <0x03>;
					segments = <0x04 0x03 0x04 0x04 0x04 0x05 0x04 0x00 0x04 0x01 0x04 0x02 0x04 0x06>;
				};
			};

			leds {
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				led@0,1 {
					reg = <0x00 0x01>;
					function = "usb";
				};

				led@0,2 {
					reg = <0x00 0x02>;
					function = "play";
				};

				led@0,3 {
					reg = <0x00 0x03>;
					function = "pause";
				};

				led@0,4 {
					reg = <0x00 0x04>;
					function = "colon";
				};

				led@0,5 {
					reg = <0x00 0x05>;
					function = "ethernet";
				};

				led@0,6 {
					reg = <0x00 0x06>;
					function = "wifi";
				};
			};
		};
	};
};
