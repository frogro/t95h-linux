CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=m
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y

# Explicit defaults for newly enabled dependencies.
# CONFIG_IOMMU_IO_PGTABLE_LPAE_SELFTEST is not set
# CONFIG_IOMMU_IO_PGTABLE_ARMV7S is not set
# CONFIG_IOMMU_IO_PGTABLE_DART is not set
# CONFIG_IOMMU_DEBUGFS is not set
# CONFIG_IOMMU_DEFAULT_DMA_LAZY is not set
# CONFIG_IOMMU_DEFAULT_PASSTHROUGH is not set
# CONFIG_IOMMUFD is not set
CONFIG_SUN50I_IOMMU=y
# CONFIG_ARM_SMMU is not set
# CONFIG_ARM_SMMU_V3 is not set
# CONFIG_DEVFREQ_GOV_PERFORMANCE is not set
# CONFIG_DEVFREQ_GOV_POWERSAVE is not set
# CONFIG_DEVFREQ_GOV_USERSPACE is not set
# CONFIG_DEVFREQ_GOV_PASSIVE is not set
# CONFIG_ARM_SUN8I_A33_MBUS_DEVFREQ is not set
# CONFIG_PM_DEVFREQ_EVENT is not set

# Explicit defaults for the selected IR and router modules.
# CONFIG_IR_IMON_DECODER is not set
# CONFIG_IR_MCE_KBD_DECODER is not set
# CONFIG_IR_RCMM_DECODER is not set
# CONFIG_IR_SANYO_DECODER is not set
# CONFIG_IR_SHARP_DECODER is not set
# CONFIG_IR_XMP_DECODER is not set
# CONFIG_IR_GPIO_TX is not set
# CONFIG_IR_PWM_TX is not set
# CONFIG_IR_SPI is not set
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y

# Native package modules override sunxi generic built-in defaults.
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_COMPRESS_OFFLOAD=m

CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Explicit defaults for multimedia dependencies.
# CONFIG_VIDEO_SUN8I_DEINTERLACE is not set
# CONFIG_VIDEO_SUN8I_ROTATE is not set
# CONFIG_VIDEO_HANTRO is not set
CONFIG_DRM_FBDEV_OVERALLOC=100
# CONFIG_DRM_DW_HDMI_GP_AUDIO is not set

# Explicit defaults for new dependency questions.
# CONFIG_MEDIA_CEC_RC is not set
# CONFIG_CEC_CH7322 is not set
# CONFIG_USB_PULSE8_CEC is not set
# CONFIG_USB_RAINSHADOW_CEC is not set
# CONFIG_VIDEO_MAX96712 is not set
CONFIG_VIDEO_SUNXI=y
# CONFIG_VIDEO_SUN6I_ISP is not set
# CONFIG_STAGING_MEDIA_DEPRECATED is not set

CONFIG_T95H_GUARDED_POWER_DOMAINS=y

# Explicit defaults for new dependency questions.
# CONFIG_BPF_LIRC_MODE2 is not set
# CONFIG_USB_EXTRON_DA_HD_4K_PLUS_CEC is not set
