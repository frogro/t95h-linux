@@ -6,6 +6,7 @@
  */
 
 #include <linux/err.h>
+#include <linux/of.h>
 #include <linux/pm_runtime.h>
 #include <linux/sysfs.h>
 
@@ -1221,6 +1222,17 @@
 	if (err)
 		return err;
 
+	if (!ocr && of_property_read_bool(host->parent->of_node,
+					 "t95h,retry-empty-sdio-ocr")) {
+		for (i = 0; i < 3 && !ocr; i++) {
+			dev_warn(mmc_dev(host), "T95H empty SDIO OCR, reset retry %d\n", i + 1);
