config wifi-device 'radio0'
 option type 'mac80211'
 option phy 'phy0'
 option country 'DE'
 option band '2g'
 option channel '1'
 option htmode 'HT20'
 option disabled '0'

config wifi-iface 'default_radio0'
 option device 'radio0'
 option network 'lan'
 option mode 'ap'
 option ssid 'OpenWrt'
 option encryption 'psk2'
 option key 'openwrtopenwrt'
