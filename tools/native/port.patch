diff --git a/target/linux/sunxi/files/arch/arm64/boot/dts/allwinner/sun50i-h616-t95h.dts b/target/linux/sunxi/files/arch/arm64/boot/dts/allwinner/sun50i-h616-t95h.dts
new file mode 100644
index 0000000..3dde458
--- /dev/null
+++ b/target/linux/sunxi/files/arch/arm64/boot/dts/allwinner/sun50i-h616-t95h.dts
@@ -0,0 +0,356 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/dts-v1/;
+#include "sun50i-h616.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+    model = "T95H OpenWrt native-kernel bring-up";
+    compatible = "t95h,h616-tvbox", "allwinner,sun50i-h616";
+    aliases { serial0 = &uart0; mmc0 = &mmc0; };
+    chosen { stdout-path = "serial0:115200n8"; };
+    /* Initial test retains rails established by the tested T95H SPL. */
+    vcc5v: regulator-5v {
+        compatible = "regulator-fixed";
+        regulator-name = "vcc-5v";
+        regulator-min-microvolt = <5000000>;
+        regulator-max-microvolt = <5000000>;
+        regulator-always-on;
+    };
+    vcc3v3: regulator-3v3 {
+        compatible = "regulator-fixed";
+        regulator-name = "vcc-3v3";
+        regulator-min-microvolt = <3300000>;
+        regulator-max-microvolt = <3300000>;
+        regulator-always-on;
+    };
+    usb1_vbus: regulator-usb1-vbus {
+        compatible = "regulator-fixed";
+        regulator-name = "usb1-vbus";
+        regulator-min-microvolt = <5000000>;
+        regulator-max-microvolt = <5000000>;
+        vin-supply = <&vcc5v>;
+        gpio = <&pio 7 8 GPIO_ACTIVE_HIGH>;
+        enable-active-high;
+    };
+};
+&pio {
+    vcc-pf-supply = <&vcc3v3>;
+    vcc-ph-supply = <&vcc3v3>;
+    vcc-pi-supply = <&vcc3v3>;
+};
+&uart0 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&uart0_ph_pins>;
+    status = "okay";
+};
+&mmc0 {
+    vmmc-supply = <&vcc3v3>;
+    cd-gpios = <&pio 8 16 GPIO_ACTIVE_LOW>;
+    disable-wp;
+    bus-width = <4>;
+    max-frequency = <25000000>;
+    no-mmc;
+    no-sdio;
+    status = "okay";
+};
+/* Controller access only, matching prepare-access-dtb.py in the tested port.
+ * This does not install to eMMC or change the SD root/boot selection.
+ */
+&mmc2 {
+ vmmc-supply = <&vcc3v3>;
+ status = "okay";
+ bus-width = <8>;
+ max-frequency = <25000000>;
+ non-removable;
+ no-sd;
+ no-sdio;
+ voltage-ranges = <3300 3300>;
+ /delete-property/ cap-sd-highspeed;
+ /delete-property/ cap-mmc-highspeed;
+ /delete-property/ mmc-ddr-3_3v;
+ /delete-property/ cap-sdio-irq;
+};
+&usbphy {
+    usb0_vbus-supply = <&vcc5v>;
+    usb1_vbus-supply = <&usb1_vbus>;
+    usb2_vbus-supply = <&vcc5v>;
+    usb3_vbus-supply = <&vcc5v>;
+    status = "okay";
+};
+&usbotg { dr_mode = "host"; status = "okay"; };
+&ehci0 { status = "okay"; };
+&ohci0 { status = "okay"; };
+&ehci1 { status = "okay"; };
+&ohci1 { status = "okay"; };
+&ehci2 { status = "okay"; };
+&ohci2 { status = "okay"; };
+&ehci3 { status = "okay"; };
+&ohci3 { status = "okay"; };
+
+/* AC200 clock and second Ethernet MAC, backported from the tested T95H tree. */
+/ { soc {
+pwm: pwm@300a000 {
+			compatible = "allwinner,sun50i-h616-pwm";
+			reg = <0x0300a000 0x400>;
+			clocks = <&osc24M>, <&ccu CLK_BUS_PWM>;
+			clock-names = "mod", "bus";
+			resets = <&ccu RST_BUS_PWM>;
+			#pwm-cells = <3>;
+			#clock-cells = <1>;
+			status = "disabled";
+		};
+emac1: ethernet@5030000 {
+			compatible = "allwinner,sun50i-h616-emac1";
+			reg = <0x05030000 0x10000>;
+			interrupts = <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "macirq";
+			clocks = <&ccu CLK_BUS_EMAC1>;
+			clock-names = "stmmaceth";
+			resets = <&ccu RST_BUS_EMAC1>;
+			reset-names = "stmmaceth";
+			syscon = <&syscon>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&rmii_emac1_pins>;
+			phy-mode = "rmii";
+			status = "disabled";
+
+			mdio1: mdio {
+				compatible = "snps,dwmac-mdio";
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+		};
+}; };
+&pio {
+rmii_emac1_pins: rmii-emac1-pins {
+				pins = "PA0", "PA1", "PA2", "PA3", "PA4",
+				       "PA5", "PA6", "PA7", "PA8", "PA9";
+				function = "emac1";
+				drive-strength = <40>;
+			};
+pwm5_pin: pwm5-pin {
+				pins = "PA12";
+				function = "pwm5";
+			};
+};
+/ { aliases { ethernet0 = &emac1; }; };
+&pio {
+ vcc-pa-supply = <&vcc3v3>;
+ i2c3_pa_pins: i2c3-pa-pins { pins = "PA10", "PA11"; function = "i2c3"; bias-pull-up; };
+};
+&sid {
+ ephy_config: ethernet-phy-configuration@2c { reg = <0x2c 2>; };
+};
+&pwm { pinctrl-names = "default"; pinctrl-0 = <&pwm5_pin>; status = "okay"; };
+&i2c3 {
+ pinctrl-0 = <&i2c3_pa_pins>; pinctrl-names = "default"; clock-frequency = <200000>; status = "okay";
+ ac200: mixed-signal@10 { compatible = "x-powers,ac200"; reg = <0x10>; clocks = <&pwm 5>; assigned-clocks = <&pwm 5>; assigned-clock-rates = <24000000>; };
+};
+&emac1 {
+ pinctrl-names = "default"; pinctrl-0 = <&rmii_emac1_pins>;
+ phy-mode = "rmii"; phy-handle = <&ephy>; phy-supply = <&vcc3v3>;
+ allwinner,tx-delay-ps = <700>; allwinner,rx-delay-ps = <3100>;
+ status = "okay";
+};
+&mdio1 {
+ ethernet-phy-package@0 {
+  compatible = "x-powers,ac200-ephy-package";
+  reg = <0>; #address-cells = <1>; #size-cells = <0>;
+  vcc-supply = <&vcc3v3>; x-powers,ac200 = <&ac200>;
+  nvmem-cells = <&ephy_config>;
+  nvmem-cell-names = "configuration";
+  /* 6.12 regulator API resolves the consumer node; mirror package supply. */
+  ephy: ethernet-phy@0 { vcc-supply = <&vcc3v3>; compatible = "ethernet-phy-id0044.1400"; reg = <0>; };
+ };
+};
+
+/* XR819 wiring and reset timing from the tested T95H device tree. */
+#include <dt-bindings/clock/sun6i-rtc.h>
+/ {
+ aliases { mmc1 = &mmc1; ethernet1 = &xr819; };
+ vcc1v8: regulator-1v8 {
+  compatible = "regulator-fixed";
+  regulator-name = "vcc-1v8";
+  regulator-min-microvolt = <1800000>;
+  regulator-max-microvolt = <1800000>;
+  regulator-always-on;
+ };
+ wifi_pwrseq: wifi-pwrseq {
+  compatible = "mmc-pwrseq-simple";
+  pinctrl-names = "default";
+  pinctrl-0 = <&wifi_clk_pin>;
+  clocks = <&rtc CLK_OSC32K_FANOUT>;
+  clock-names = "ext_clock";
+  assigned-clocks = <&rtc CLK_OSC32K_FANOUT>;
+  /* 6.12 ccu-sun6i-rtc exports OSC24M/750 at index 5. */
+  assigned-clock-parents = <&rtc 5>;
+  reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>;
+  post-power-on-delay-ms = <300>;
+  power-off-delay-us = <100000>;
+ };
+};
+&pio {
+ vcc-pg-supply = <&vcc1v8>;
+ wifi_clk_pin: wifi-clk-pin { pins = "PG10"; function = "clock"; };
+ wifi_wake_pin: wifi-wake-pin { pins = "PG15"; function = "gpio_in"; };
+};
+&r_i2c {
+ status = "okay";
+ wlan_supply: regulator@36 {
+  compatible = "t95h,aldo2-only-test";
+  reg = <0x36>;
+  regulator-name = "t95h-aldo2-wlan";
+  regulator-min-microvolt = <3300000>;
+  regulator-max-microvolt = <3300000>;
+  regulator-boot-on;
+  regulator-always-on;
+ };
+};
+&mmc1 {
+ vmmc-supply = <&wlan_supply>;
+ vqmmc-supply = <&vcc1v8>;
+ mmc-pwrseq = <&wifi_pwrseq>;
+ bus-width = <4>;
+ max-frequency = <25000000>;
+ non-removable;
+ no-mmc;
+ no-sd;
+ cap-sdio-irq;
+ keep-power-in-suspend;
+ t95h,retry-empty-sdio-ocr;
+ status = "okay";
+ xr819: wifi@1 {
+  reg = <1>;
+  compatible = "xradio,xr819";
+  pinctrl-names = "default";
+  pinctrl-0 = <&wifi_wake_pin>;
+  interrupt-parent = <&pio>;
+  interrupts = <6 15 IRQ_TYPE_EDGE_RISING>;
+  interrupt-names = "host-wake";
+ };
+};
+
+/* Dedicated FD655 bus from the tested board wiring: PI12 SDA, PI11 SCL.
+ * The guarded userspace helper owns this bus; no competing display client.
+ */
+/ {
+ i2c-display {
+  compatible = "i2c-gpio";
+  sda-gpios = <&pio 8 12 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  scl-gpios = <&pio 8 11 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  i2c-gpio,delay-us = <5>;
+  #address-cells = <1>;
+  #size-cells = <0>;
+ };
+};
+
+/* CPU/GPU are brought up together by t95h-compute after network readiness. */
+&wlan_supply {
+ t95h_cpu_supply: cpu-regulator {
+  regulator-name = "t95h-cpu-dcdca";
+  regulator-min-microvolt = <900000>;
+  regulator-max-microvolt = <1120000>;
+  regulator-boot-on;
+  regulator-always-on;
+ };
+ t95h_gpu_supply: gpu-regulator {
+  regulator-name = "t95h-gpu-inherited";
+  regulator-min-microvolt = <960000>;
+  regulator-max-microvolt = <1100000>;
+  regulator-boot-on;
+  regulator-always-on;
+ };
+};
+/ {
+ t95h_cpu_opp: opp-table-cpu {
+  compatible = "allwinner,sun50i-h616-operating-points";
+  nvmem-cells = <&cpu_speed_grade>;
+  opp-shared;
+  opp-408000000 { opp-hz = /bits/ 64 <408000000>; opp-microvolt = <900000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+  opp-480000000 { opp-hz = /bits/ 64 <480000000>; opp-microvolt = <900000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+  opp-720000000 { opp-hz = /bits/ 64 <720000000>; opp-microvolt = <900000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+  opp-936000000 { opp-hz = /bits/ 64 <936000000>; opp-microvolt = <900000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+  opp-1008000000 { opp-hz = /bits/ 64 <1008000000>; opp-microvolt = <950000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+  opp-1104000000 { opp-hz = /bits/ 64 <1104000000>; opp-microvolt = <1000000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+  opp-1200000000 { opp-hz = /bits/ 64 <1200000000>; opp-microvolt = <1050000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+  opp-1320000000 { opp-hz = /bits/ 64 <1320000000>; opp-microvolt = <1100000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+  opp-1416000000 { opp-hz = /bits/ 64 <1416000000>; opp-microvolt = <1100000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+  opp-1512000000 { opp-hz = /bits/ 64 <1512000000>; opp-microvolt = <1100000>; opp-supported-hw = <0x08>; clock-latency-ns = <5000000>; };
+ };
+ t95h_gpu_opp: opp-table-gpu {
+  compatible = "operating-points-v2";
+  opp-504000000 { opp-hz = /bits/ 64 <504000000>; opp-microvolt = <960000 960000 1100000>; };
+  opp-540000000 { opp-hz = /bits/ 64 <540000000>; opp-microvolt = <960000 960000 1100000>; };
+  opp-576000000 { opp-hz = /bits/ 64 <576000000>; opp-microvolt = <960000 960000 1100000>; };
+  opp-600000000 { opp-hz = /bits/ 64 <600000000>; opp-microvolt = <960000 960000 1100000>; };
+ };
+ soc {
+  t95h_ppu: power-controller@7010250 {
+   compatible = "allwinner,sun50i-h616-prcm-ppu";
+   reg = <0x07010250 0x10>;
+   #power-domain-cells = <1>;
+  };
+  t95h_gpu: gpu@1800000 {
+   compatible = "allwinner,sun50i-h616-mali", "arm,mali-bifrost";
+   reg = <0x01800000 0x40000>;
+   interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 96 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
+   interrupt-names = "job", "mmu", "gpu";
+   clocks = <&ccu CLK_GPU0>, <&ccu CLK_BUS_GPU>;
+   clock-names = "core", "bus";
+   resets = <&ccu RST_BUS_GPU>;
+   power-domains = <&t95h_ppu 2>;
+   mali-supply = <&t95h_gpu_supply>;
+   operating-points-v2 = <&t95h_gpu_opp>;
+   #cooling-cells = <2>;
+   status = "okay";
+  };
+ };
+ thermal-zones { cpu-thermal { cooling-maps {
+  map0 { trip = <&cpu_threshold>; cooling-device = <&cpu0 6 9>, <&cpu1 6 9>, <&cpu2 6 9>, <&cpu3 6 9>; };
+  map1 { trip = <&cpu_target>; cooling-device = <&cpu0 9 9>, <&cpu1 9 9>, <&cpu2 9 9>, <&cpu3 9 9>; };
+ }; }; };
+};
+&cpu0 { cpu-supply = <&t95h_cpu_supply>; operating-points-v2 = <&t95h_cpu_opp>; };
+&cpu1 { operating-points-v2 = <&t95h_cpu_opp>; };
+&cpu2 { operating-points-v2 = <&t95h_cpu_opp>; };
+&cpu3 { operating-points-v2 = <&t95h_cpu_opp>; };
+&cpu_threshold { temperature = <65000>; hysteresis = <2000>; };
+&cpu_target { temperature = <70000>; hysteresis = <2000>; };
+
+/ { thermal-zones { gpu-thermal {
+ trips { t95h_gpu_passive: gpu-passive { temperature = <65000>; hysteresis = <2000>; type = "passive"; }; };
+ cooling-maps { map0 { trip = <&t95h_gpu_passive>; cooling-device = <&t95h_gpu 3 3>; }; };
+}; }; };
+
+/* Native 6.12 sunxi IR driver uses the existing board IR pin. */
+&ir { status = "okay"; };
+
+#include "t95h-multimedia.dtsi"
+/ {
+ hdmi-connector {
