+&hdmi_out { t95h_hdmi_output: endpoint { remote-endpoint = <&t95h_hdmi_connector>; }; };
+&tcon_tv0 { status = "okay"; };
+&tcon_tv1 { status = "disabled"; };
+&iommu { status = "okay"; };
+&t95h_ve { status = "okay"; };
+&codec {
+ status = "okay";
+ assigned-clocks = <&ccu CLK_AUDIO_CODEC_1X>;
+ assigned-clock-parents = <&ccu CLK_PLL_AUDIO_2X>;
+ allwinner,audio-routing = "Line Out", "LINEOUT";
+};
+&ahub_dam_plat {
+ status = "okay";
+ clocks = <&ccu CLK_PLL_AUDIO_4X>, <&ccu CLK_PLL_AUDIO_4X>, <&ccu CLK_AUDIO_HUB>, <&ccu CLK_BUS_AUDIO_HUB>;
+};
+&ahub1_plat { status = "okay"; };
+&ahub1_mach { status = "okay"; };
+
+&ahub1_cpu { soundcard-mach,pll-fs = <2>; };
